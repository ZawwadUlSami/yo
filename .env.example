# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/reddit-growth-tool

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Reddit API Configuration
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://localhost:3000/auth/reddit/callback

# OpenAI API (for AI post generation)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: You can use other AI providers like Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
