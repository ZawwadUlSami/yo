# Environment configuration example
# Copy this file to .env and adjust settings as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Image Processing
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
DEFAULT_OUTPUT_FORMAT=png
DEFAULT_QUALITY=95

# Background Removal
BG_MODEL=u2net  # Options: u2net, u2netp, u2net_human_seg

# Output Settings
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Optimization
ENABLE_OPTIMIZATION=true
MAX_WIDTH=2000
MAX_HEIGHT=2000
